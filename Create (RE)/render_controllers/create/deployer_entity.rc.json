{
    "format_version": "1.8.0",
    "render_controllers": {
        "controller.render.create_bedrock.create.deployer_entity": {
            "geometry": "Geometry.default",
            "materials": [{ "*": "Material.default" }],
            "textures": ["Texture.default"],
            "part_visibility": [
                { "holding": "q.is_item_equipped || q.property('create:hand_mode')" },
                { "Handdeployer": "q.property('create:hand_mode')" },
                { "Open": "q.is_item_equipped && !q.property('create:hand_mode')" },
                { "pointing": "!(q.is_item_equipped || q.property('create:hand_mode'))" },
                { "Pointing2": "!(q.is_item_equipped || q.property('create:hand_mode'))" }
            ]
        }
    }
}

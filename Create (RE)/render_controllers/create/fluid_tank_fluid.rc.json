{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.create_bedrock.create.fluid_tank_fluid": {
      "arrays": {
        "textures": {
          "Array.fluid": [
            "Texture.lava",
            "Texture.water",
            "Texture.honey",
            "Texture.chocolate",
            "Texture.milk"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {"*": "Material.default"}
      ],
      "uv_anim": {
        "offset": [0.0, 0.0],
        "scale": [
          "math.max(1.0, q.property('create:tank_width'))",
          "math.max(1.0, q.property('create:fluid_height'))"
        ]
      },
      "textures": [
        "Array.fluid[q.property('create:fluid_type') == 'milk' ? 4 : (q.property('create:fluid_type') == 'chocolate' ? 3 : (q.property('create:fluid_type') == 'honey' ? 2 : (q.property('create:fluid_type') == 'water' ? 1 : 0)))]"
      ]
    }
  }
}

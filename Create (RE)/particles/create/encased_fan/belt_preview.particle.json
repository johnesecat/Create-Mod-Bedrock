				],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [8, 8],
						"step_UV": [8, 0],
						"frames_per_second": 28,
						"max_frame": 8,
						"stretch_to_lifetime": true,
						"loop": false
					}
				}
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": [
					"math.clamp(v.color_r * (0.65 + variable.particle_random_1 * 0.5), 0, 1)",
					"math.clamp(v.color_g * (0.65 + variable.particle_random_1 * 0.5), 0, 1)",
					"math.clamp(v.color_b * (0.65 + variable.particle_random_1 * 0.5), 0, 1)",
					1.0
				]
			}
		}
	}

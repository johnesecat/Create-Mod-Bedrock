      "materials": { "default": "entity_alphatest" },
      "textures": { "default": "textures/blocks/ladder" },
      "geometry": { "default": "geometry.create_bedrock.create.ladder_construct" },
      "animations": {
        "rotate": "animation.create_bedrock.create.mechanical_bearing_construct.rotate",
        "direction": "animation.create_bedrock.create.ladder_construct.direction"
      },
      "scripts": {
        "animate": ["rotate", "direction"],
        "pre_animation": [
          "v.angle_x = q.property('create:rotation_x');",
          "v.angle_y = q.property('create:rotation_y');",
          "v.angle_z = q.property('create:rotation_z');",
          "v.ladder_direction = q.property('create:ladder_direction');"
        ]
      },
      "render_controllers": ["controller.render.create_bedrock.create.ladder_construct"]
    }
  }
}

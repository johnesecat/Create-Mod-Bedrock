{
  "format_version": "1.26.50",
  "minecraft:client_entity": {
    "description": {
      "identifier": "create:glass_door_visual_lower",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/create/common/blocks/glass_door"
      },
      "geometry": {
        "default": "geometry.create_bedrock.create.glass_door_entity"
      },
      "animations": {
        "fixed": "animation.create_bedrock.model.fixed_north",
        "open": "animation.create_bedrock.model.open2",
        "close": "animation.create_bedrock.model.close2",
        "open_reverse": "animation.create_bedrock.model.open2_reverse",
        "close_reverse": "animation.create_bedrock.model.close2_reverse"
      },
      "scripts": {
        "animate": [
          "fixed",
          { "open": "q.property('create:opening') && !q.property('create:hinge')" },
          { "close": "!q.property('create:opening') && !q.property('create:hinge')" },
          { "open_reverse": "q.property('create:opening') && q.property('create:hinge')" },
          { "close_reverse": "!q.property('create:opening') && q.property('create:hinge')" }
        ]
      },
      "render_controllers": [
        "controller.render.create_bedrock.create.andesite_door_visual"
      ]
    }
  }
}



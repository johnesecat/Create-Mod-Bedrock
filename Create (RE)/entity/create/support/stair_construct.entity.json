{
    "format_version": "1.26.50",
    "minecraft:client_entity": {
        "description": {
            "identifier": "create:stair_construct",
            "materials": { "default": "entity_alphatest" },
            "textures": { "default": "textures/create/common/blocks/invisible_texture" },
            "geometry": { "default": "geometry.create_bedrock.create.stair_construct" },
            "enable_attachables": true,
            "animations": { "rotate": "animation.create_bedrock.create.stair_construct.rotate" },
            "scripts": {
                "animate": [ "rotate" ],
                "pre_animation": [
                    "v.angle_x = q.property('create:rotation_x');",
                    "v.angle_y = q.property('create:rotation_y');",
                    "v.angle_z = q.property('create:rotation_z');",
                    "v.stair_flip = q.property('create:stair_upside_down') ? 180 : 0;"
                ]
            },
            "render_controllers": [ "controller.render.default" ]
        }
    }
}

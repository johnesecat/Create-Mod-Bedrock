{
    "format_version": "1.26.50",
    "minecraft:client_entity": {
        "description": {
            "identifier": "create:mechanical_crafter_item",
            "materials": {
                "default": "zombie"
            },
            "textures": {
                "default": "textures/create/common/blocks/invisible_texture"
            },
            "geometry": {
                "default": "geometry.create_bedrock.create.display_item"
            },
            "enable_attachables": true,
            "animations": {
                "item": "animation.create_bedrock.create.mechanical_crafter_item.item",
                "frame_item": "animation.create_bedrock.create.mechanical_crafter_item.frame_item",
                "frame_item_flat": "animation.create_bedrock.create.mechanical_crafter_item.frame_item_flat",
                "block": "animation.create_bedrock.create.mechanical_crafter_item.block",
                "hand_equipped": "animation.create_bedrock.create.mechanical_crafter_item.hand_equipped"
            },
            "scripts": {
                "animate": [
                    { "item": "q.property('create:item_visual') == 'item'" },
                    { "frame_item": "q.property('create:item_visual') == 'frame_item'" },
                    { "frame_item_flat": "q.property('create:item_visual') == 'frame_item_flat'" },
                    { "block": "q.property('create:item_visual') == 'block'" },
                    { "hand_equipped": "q.property('create:item_visual') == 'hand_equipped'" }
                ],
                "initialize": [
                    "v.second_item_rot = math.random(25, 135) * ((math.random_integer(0, 1) * 2) - 1);",
                    "v.second_block_offset_x = math.random(0, 0.75);",
                    "v.second_block_offset_z = math.random(0, 0.75);",
                    "v.second_block_rot = 0;"
                ],
                "pre_animation": [
                    "v.right_rotation_x = q.property('create:rotation_x');",
                    "v.right_rotation_y = q.property('create:rotation_y');",
                    "v.right_rotation_z = q.property('create:rotation_z');",
                    "v.left_rotation_x = q.property('create:rotation_x');",
                    "v.left_rotation_y = q.property('create:rotation_y');",
                    "v.left_rotation_z = q.property('create:rotation_z');",
                    "v.item_scale = q.property('create:item_scale');",
                    "v.second_block_rot = q.property('create:rotation_y') - 180;"
                ]
            },
            "render_controllers": ["controller.render.default"]
        }
    }
}


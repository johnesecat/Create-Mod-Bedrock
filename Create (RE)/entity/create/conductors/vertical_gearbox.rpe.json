{
    "format_version": "1.26.50",
    "minecraft:client_entity": {
        "description": {
            "identifier": "create:vertical_gearbox_entity",
            "materials": {
                "default": "create_entity_block"
            },
            "textures": {
                "default": "textures/create/common/blocks/gearbox"
            },
            "geometry": {
                "default": "geometry.create_bedrock.create.vertical_gearbox_entity"
            },
             "animations": {
                "offset": "animation.create.rpm.offsets",
                "gearbox": "animation.create_bedrock.create.rpm.gearbox"
            },
            "scripts": {
                "animate": [ "offset", "gearbox" ],
                "pre_animation": [
                    "v.rotation = q.property('create:cardinal_rotation');",
                    "v.offset_sign = 1;",

                    "v.visual_sign = 1;",
                    "v.rpm = ((q.frame_alpha + q.time_stamp) / 3.33) * -q.property('create:rpm');",
                    "v.rpm2 = 0;",

                    "v.sourceDir = q.property('create:source_direction');",
                    "v.sign = v.sourceDir == 'east' || v.sourceDir == 'south' || v.sourceDir == 'above' ? -1 : 1;",
                    
                    "v.rpm_n = v.rpm * v.sign;",
                    "v.rpm_s = v.rpm * -v.sign;",
                    "v.rpm_e = v.rpm * v.sign;",
                    "v.rpm_w = v.rpm * -v.sign;"
                ]
            },
            "render_controllers": [
                "controller.render.default"
            ]
        }
    }
}
{
    "format_version": "1.26.50",
    "minecraft:client_entity": {
        "description": {
            "identifier": "create:mechanical_mixer_entity",
            "materials": {
                "default": "create_entity_block"
            },
            "textures": {
                "default": "textures/create/common/blocks/mechanical_mixer"
            },
            "geometry": {
                "default": "geometry.create_bedrock.create.mechanical_mixer_entity"
            },
            "animations": {
                "rotation":             "animation.create.rpm.rotation",
                "offset":              "animation.create.rpm.offsets",
                "spin":                 "animation.create_bedrock.create.mechanical_mixer.spin"
            },
            "scripts": {
                "animate": [
                    "rotation",
                    "offset",
                    "spin"
                ],
                "pre_animation": [
                    "v.rotation = q.property('create:cardinal_rotation');",
                    "v.offset_sign = 1;",

                    "v.visual_sign = 1;",
                    "v.rpm = ((q.frame_alpha + q.time_stamp) / 3.33) * -q.property('create:rpm');",
                    "v.rpm2 = 0;"
                ]
            },
            "render_controllers": [
                "controller.render.default"
            ]
        }
    }
}
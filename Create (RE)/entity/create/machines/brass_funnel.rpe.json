{
    "format_version": "1.26.50",
    "minecraft:client_entity": {
        "description": {
            "identifier": "create:brass_funnel_entity",
            "materials": { "default": "zombie" },
            "textures":  { "default": "textures/create/common/blocks/invisible" },
            "geometry":  { "default": "geometry.create_bedrock.create.brass_funnel_entity" },
            "animations": {
                "constant":     "animation.create_bedrock.create.brass_funnel.constant",
                "filter_item":  "animation.create_bedrock.create.brass_funnel.filter_item",
                "filter_block": "animation.create_bedrock.create.brass_funnel.filter_block",
                "filter_hand_equipped": "animation.create_bedrock.create.brass_funnel.filter_hand_equipped"
            },
            "scripts": {
                "animate": [
                    "constant",
                    { "filter_item":  "q.property('create:type') == 'item'" },
                    { "filter_block": "q.property('create:type') == 'block'" },
                    { "filter_hand_equipped": "q.property('create:type') == 'hand_equipped'" }
                ]
            },
            "render_controllers": ["controller.render.default"]
        }
    }
}

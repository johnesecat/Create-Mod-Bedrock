{
    "format_version": "1.10.0",
    "animations": {
        "animation.create_bedrock.create.mechanical_arm.rot_0": {
            "loop": "hold_on_last_frame",
            "bones": {
                "moving": { "rotation": [0, "v.base", 0] },
                "arm":    { "rotation": ["v.shoulder", 0, 0] },
                "arm2":   { "rotation": ["v.elbow", 0, 0] }
            }
        },
        "animation.create_bedrock.create.mechanical_arm.rot_1": {
            "loop": "hold_on_last_frame",
            "bones": {
                "moving": { "rotation": [0, "v.base_new", 0] },
                "arm":    { "rotation": ["v.shoulder_new", 0, 0] },
                "arm2":   { "rotation": ["v.elbow_new", 0, 0] }
            }
        },
        "animation.create_bedrock.create.mechanical_arm.claw_item": {
            "loop": true,
            "bones": {
                "claw_item": { "scale": 2 },
                "root": {
                    "rotation": [0, "v.rotation == 'south' ? 180 : v.rotation == 'west' ? 270 : v.rotation == 'north' ? 0 : v.rotation == 'east' ? 90 : 0", 0]
                },
                "pivot": {
                    "rotation": [-74, -11.5, -15],
                    "position": [0.3, -2.1, 0.75]
                },
                "leftitem": { "scale": 0.4 }
            }
        },
        "animation.create_bedrock.create.mechanical_arm.claw_block": {
            "loop": true,
            "bones": {
                "claw_item": { "scale": 2 },

{
    "format_version": "1.8.0",
    "animations": {
        "animation.create.brass_funnel.constant": {
            "loop": true,
            "bones": {
                "all": {
                    "rotation": [0, "q.property('create:cardinal_rotation') == 'south' ? 180 : q.property('create:cardinal_rotation') == 'west' ? 270 : q.property('create:cardinal_rotation') == 'east' ? 90 : 0", 0],
                    "position": [0, -8, 0]
                },
                "root2": {
                    "position": [0, 0, "q.property('create:parallel') ? 0 : 0"]
                }
            }
        },
        "animation.create.brass_funnel.filter_item": {
            "loop": true,
            "bones": {
                "bone2":  { "scale": 1.5, "position": [0, 0, 0] },
                "pivot2": { "rotation": [-74, -11.5, -15], "position": [-0.45, -3, 2.4] },
                "rightitem": { "scale": 0.4, "rotation": [0,0,0] }
            }
        },
        "animation.create.brass_funnel.filter_hand_equipped": {
            "loop": true,
            "bones": {
                "bone2": { "scale": 1.5, "position": [0, 0, 0] },
                "pivot2": { "rotation": [0, 0, 0], "position": [0, -2.4, 2.45] },
                "rightitem": { "scale": 0.25, "rotation": [-90, 90, 0] }
            }
        },
        "animation.create.brass_funnel.filter_block": {
            "loop": true,
            "bones": {
                "pivot2":    { "rotation": [-20, 225, 0], "position": [-2.5, -0.26, -0.4] },
                "rightitem": { "scale": 0.6 }
            }
        }
    }
}

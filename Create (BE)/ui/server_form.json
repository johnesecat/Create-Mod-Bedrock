{
    "third_party_server_screen@common.base_screen": {
        "$screen_content": "server_form.main_screen_content",
        "$screen_animations": [],
        "button_mappings": [
            {
                "from_button_id": "button.menu_cancel",
                "to_button_id": "button.menu_exit",
                "mapping_type": "global"
            }
        ]
    },
    "main_screen_content": {
        "size": ["100%", "100%"],
        "modifications": [
            {
                "array_name": "controls",
                "operation": "insert_back",
                "value": [
                    {
                        "rpm_screen_factory": {
                            "type": "panel",
                            "factory": {
                                "name": "server_form_factory",
                                "control_ids": {
                                    "custom_form": "@rpm_screen.rpm_screen_panel"
                                }
                            }
                        }
                    },
                    {
                        "funnel_screen_factory": {
                            "type": "panel",
                            "factory": {
                                "name": "server_form_factory",
                                "control_ids": {
                                    "custom_form": "@funnel_screen.funnel_screen_panel"
                                }
                            }
                        }
                    }
                ]
            }
        ]
    },
    "custom_form": {
        "modifications": [
            {
                "array_name": "bindings",
                "operation": "insert_back",
                "value": [
                    {
                        "binding_name": "#title_text"
                    },
                    {
                        "binding_type": "view",
                        "source_property_name": "(((#title_text - 'create:rpm.') = #title_text) and ((#title_text - 'create:funnel.') = #title_text))",
                        "target_property_name": "#visible"
                    }
                ]
            }
        ]
    }
}

{
  "format_version": "1.21.90",
  "minecraft:block": {
    "description": {
      "identifier": "create:ladder_andesite",
      "states": { "create:connected_above": [false, true] },
      "traits": { "minecraft:placement_direction": { "enabled_states": ["minecraft:cardinal_direction"] } }
    },
    "components": {
      "create:before_place": {},
      "create:on_tick": {},
      "minecraft:tick": { "looping": true, "interval_range": [4, 8] },
      "minecraft:geometry": { "identifier": "geometry.ladder" },
      "minecraft:material_instances": { "*": { "texture": "create:ladder_andesite", "render_method": "alpha_test", "ambient_occlusion": false } },
      "tag:minecraft:is_climbable": {},
      "minecraft:collision_box": { "origin": [-8, 0, 6], "size": [16, 16, 2] },
      "minecraft:selection_box": { "origin": [-8, 0, 6], "size": [16, 16, 2] },
      "minecraft:destructible_by_mining": { "seconds_to_destroy": 0.4 },
      "minecraft:map_color": "#77746E",
      "tag:minecraft:is_pickaxe_item_destructible": {}
    },
    "permutations": [
      { "condition": "q.block_state('create:connected_above') == true", "components": { "minecraft:material_instances": { "*": { "texture": "create:ladder_andesite_hoop", "render_method": "alpha_test", "ambient_occlusion": false } } } },
      { "condition": "q.block_state('minecraft:cardinal_direction') == 'north'", "components": { "minecraft:transformation": { "rotation": [0, 180, 0] } } },
      { "condition": "q.block_state('minecraft:cardinal_direction') == 'east'", "components": { "minecraft:transformation": { "rotation": [0, 90, 0] } } },
      { "condition": "q.block_state('minecraft:cardinal_direction') == 'west'", "components": { "minecraft:transformation": { "rotation": [0, -90, 0] } } }
    ]
  }
}

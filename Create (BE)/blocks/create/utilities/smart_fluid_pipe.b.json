{
  "format_version": "1.26.0",
  "minecraft:block": {
    "description": {
      "identifier": "create:smart_fluid_pipe",
      "menu_category": { "category": "items" },
      "states": {
        "create:filter": ["none", "water", "lava", "milk", "honey", "chocolate"]
      },
      "traits": {
        "minecraft:placement_direction": {
          "enabled_states": ["minecraft:facing_direction"]
        }
      }
    },
    "components": {
      "create:on_interact": {},
      "create:on_place": {},
      "create:on_break": {},
      "create:ticking": {},
      "minecraft:tick": { "interval_range": [100, 140] },
      "minecraft:geometry": {
        "identifier": "geometry.create.smart_fluid_pipe"
      },
      "minecraft:material_instances": {
        "*": {
          "texture": "create:smart_fluid_pipe",
          "render_method": "alpha_test_to_opaque",
          "ambient_occlusion": false
        }
      },
      "minecraft:item_visual": {
        "geometry": {
          "identifier": "geometry.create.smart_fluid_pipe"
        },
        "material_instances": {
          "*": {
            "texture": "create:smart_fluid_pipe",
            "render_method": "alpha_test_to_opaque",
            "ambient_occlusion": false
          }
        }
      },
      "minecraft:destruction_particles": { "texture": "create:smart_fluid_pipe" },
      "minecraft:collision_box": {
        "origin": [-5, 3, -8],
        "size": [10, 10, 16]
      },
      "minecraft:selection_box": {
        "origin": [-8, 0, -8],
        "size": [16, 16, 16]
      },
      "minecraft:destructible_by_mining": { "seconds_to_destroy": 1.5 },
      "minecraft:light_dampening": 0,
      "minecraft:map_color": "#B36A50",
      "tag:minecraft:is_pickaxe_item_destructible": {}
    },
    "permutations": [
      {
        "condition": "q.block_state('minecraft:facing_direction') == 'north'",
        "components": { "minecraft:transformation": { "rotation": [0, 180, 0] } }
      },
      {
        "condition": "q.block_state('minecraft:facing_direction') == 'east'",
        "components": { "minecraft:transformation": { "rotation": [0, 90, 0] } }
      },
      {
        "condition": "q.block_state('minecraft:facing_direction') == 'south'",
        "components": { "minecraft:transformation": { "rotation": [0, 0, 0] } }
      },
      {
        "condition": "q.block_state('minecraft:facing_direction') == 'west'",
        "components": { "minecraft:transformation": { "rotation": [0, -90, 0] } }
      },
      {
        "condition": "q.block_state('minecraft:facing_direction') == 'up'",
        "components": { "minecraft:transformation": { "rotation": [-90, 0, 0] } }
      },
      {
        "condition": "q.block_state('minecraft:facing_direction') == 'down'",
        "components": { "minecraft:transformation": { "rotation": [90, 0, 0] } }
      }
    ]
  }
}

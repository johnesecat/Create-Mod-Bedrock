{
  "format_version": "1.26.10",
  "minecraft:block": {
    "description": {
      "identifier": "create:redstone_link_receiver",
      "states": {
        "create:receiver": [false, true],
        "create:powered": [false, true],
        "create:frequency": [0, 15]
      },
      "traits": {
        "minecraft:placement_direction": {
          "enabled_states": ["minecraft:cardinal_direction"],
          "y_rotation_offset": 180
        }
      }
    },
    "components": {
      "create:on_place": {},
      "create:on_break": {},
      "create:on_interact": {},
      "create:on_tick": {},
      "minecraft:tick": { "looping": true, "interval_range": [2, 2] },
      "minecraft:redstone_producer": {
        "connected_faces": ["north", "south", "east", "west", "up", "down"],
        "strongly_powered_face": "down",
        "power": 0,
        "transform_relative": false
      },
      "minecraft:geometry": { "identifier": "geometry.redstone_link" },
      "minecraft:material_instances": {
        "*": { "texture": "create:redstone_link", "render_method": "alpha_test", "ambient_occlusion": false }
      },
      "minecraft:item_visual": {
        "geometry": { "identifier": "geometry.redstone_link" },
        "material_instances": {
          "*": { "texture": "create:redstone_link", "render_method": "alpha_test", "ambient_occlusion": false }
        }
      },
      "minecraft:collision_box": { "origin": [-6,0,-6], "size": [12,11,12] },
      "minecraft:selection_box": { "origin": [-6,0,-6], "size": [12,11,12] },
      "minecraft:destructible_by_mining": { "seconds_to_destroy": 1.5 },
      "minecraft:map_color": "#77736C",
      "tag:minecraft:is_pickaxe_item_destructible": {}
    },
    "permutations": [
      {
        "condition": "q.block_state('create:powered') == true",
        "components": {
          "minecraft:material_instances": {
            "*": { "texture": "create:redstone_link_powered", "render_method": "alpha_test", "ambient_occlusion": false }
          },
          "minecraft:redstone_producer": {
            "connected_faces": ["north", "south", "east", "west", "up", "down"],
            "strongly_powered_face": "down",
            "power": 15,
            "transform_relative": false
          }
        }
      },
      { "condition": "q.block_state('minecraft:cardinal_direction') == 'north'", "components": { "minecraft:transformation": { "rotation": [0,180,0] } } },
      { "condition": "q.block_state('minecraft:cardinal_direction') == 'east'", "components": { "minecraft:transformation": { "rotation": [0,-90,0] } } },
      { "condition": "q.block_state('minecraft:cardinal_direction') == 'west'", "components": { "minecraft:transformation": { "rotation": [0,90,0] } } }
    ]
  }
}

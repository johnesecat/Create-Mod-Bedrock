{
    "format_version": "1.26.0",
    "minecraft:block": {
        "description": {
            "identifier": "create:glass_pipe",
            "menu_category": { "category": "none" },
            "states": {
                "create:shape": ["straight", "vertical"],
                "create:end_type": ["open", "front", "back", "both"]
            },
            "traits": {
                "minecraft:placement_direction": {
                    "enabled_states": ["minecraft:cardinal_direction"]
                }
            }
        },
        "components": {
            "create:on_place": {},
            "create:on_interact": {},
            "create:on_break": {},
            "minecraft:loot": "loot_tables/create/bedrock/glass_pipe.json",
            "minecraft:geometry": { "identifier": "geometry.pipe_straight_open" },
            "minecraft:material_instances": {
                "*": {
                    "texture": "create:glass_fluid_pipe",
                    "render_method": "alpha_test",
                    "ambient_occlusion": false,
                    "face_dimming": true
                }
            },
            "minecraft:destruction_particles": { "texture": "create:glass_fluid_pipe" },
            "minecraft:collision_box": { "origin": [-5, 3, -8], "size": [10, 10, 16] },
            "minecraft:selection_box": { "origin": [-5, 3, -8], "size": [10, 10, 16] },
            "minecraft:destructible_by_mining": { "seconds_to_destroy": 1.5 },
            "minecraft:light_dampening": 0,
            "tag:minecraft:is_pickaxe_item_destructible": {}
        },
        "permutations": [
            { "condition": "q.block_state('create:end_type') == 'open'", "components": { "minecraft:geometry": { "identifier": "geometry.pipe_straight_open" } } },
            { "condition": "q.block_state('create:end_type') == 'front'", "components": { "minecraft:geometry": { "identifier": "geometry.pipe_straight_front" } } },
            { "condition": "q.block_state('create:end_type') == 'back'", "components": { "minecraft:geometry": { "identifier": "geometry.pipe_straight_back" } } },
            { "condition": "q.block_state('create:end_type') == 'both'", "components": { "minecraft:geometry": { "identifier": "geometry.pipe_straight_both" } } },
            { "condition": "q.block_state('create:shape') == 'vertical'", "components": { "minecraft:transformation": { "rotation": [90, 0, 0] } } },
            { "condition": "q.block_state('create:shape') == 'straight' && q.block_state('minecraft:cardinal_direction') == 'south'", "components": { "minecraft:transformation": { "rotation": [0, 180, 0] } } },
            { "condition": "q.block_state('create:shape') == 'straight' && q.block_state('minecraft:cardinal_direction') == 'west'", "components": { "minecraft:transformation": { "rotation": [0, 90, 0] } } },
            { "condition": "q.block_state('create:shape') == 'straight' && q.block_state('minecraft:cardinal_direction') == 'east'", "components": { "minecraft:transformation": { "rotation": [0, -90, 0] } } }
        ]
    }
}

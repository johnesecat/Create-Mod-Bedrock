{
  "format_version": "1.26.0",
  "minecraft:block": {
    "description": {
      "identifier": "create:spout",
      "menu_category": { "category": "items" },
      "states": {
        "create:has_lava": [false, true]
      },
      "traits": {
        "minecraft:placement_direction": {
          "enabled_states": ["minecraft:cardinal_direction"],
          "y_rotation_offset": 180
        }
      }
    },
    "components": {
      "create:on_interact": {},
      "create:on_place": {},
      "create:player_break": {},
      "minecraft:material_instances": {
        "*": {
          "texture": "create:spout",
          "render_method": "alpha_test",
          "ambient_occlusion": false
        }
      },
      "minecraft:collision_box": {
        "origin": [-8, 0, -8],
        "size": [16, 16, 16]
      },
      "minecraft:selection_box": {
        "origin": [-8, 0, -8],
        "size": [16, 16, 16]
      },
      "minecraft:geometry": {
        "identifier": "geometry.create_bedrock.spout"
      },
      "minecraft:item_visual": {
        "geometry": {
          "identifier": "geometry.create_bedrock.spout"
        },
        "material_instances": {
          "*": {
            "texture": "create:spout",
            "render_method": "alpha_test",
            "ambient_occlusion": false
          }
        }
      },
      "minecraft:destruction_particles": { "texture": "create:spout" },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 0.5
      },
      "minecraft:light_dampening": 0,
      "minecraft:map_color": "#60432A"
    },
    "permutations": [
      {
        "condition": "q.block_state('create:has_lava')",
        "components": {
          "create:ticking": {},
          "minecraft:tick": {
            "interval_range": [4, 6]
          },
          "minecraft:geometry": {
            "identifier": "geometry.spout_on"
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'north'",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, 0, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'east'",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, 270, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'south'",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, 180, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'west'",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, 90, 0]
          }
        }
      }
    ]
  }
}

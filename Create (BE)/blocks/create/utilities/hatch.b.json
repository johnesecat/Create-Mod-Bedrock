{
    "format_version": "1.26.0",
    "minecraft:block": {
        "description": {
            "identifier": "create:hatch",
            "menu_category": { "category": "items" },
            "traits": {
                "minecraft:placement_direction": {
                    "enabled_states": [ "minecraft:cardinal_direction" ],
                    "y_rotation_offset": 180
                }
            },
            "states": {
                "create:open": [ false, true ]
            }
        },
        "components": {
            "create:on_interact": {},
            "minecraft:material_instances": {
                "*": {
                    "texture": "create:hatch_closed",
                    "render_method": "alpha_test_to_opaque",
                    "ambient_occlusion": false
                }
            },
            "minecraft:geometry": {
                "identifier": "geometry.hatch"
            },
            "minecraft:collision_box": {
                "origin": [ -8, 0, -8 ],
                "size": [ 16, 16, 10 ]
            },
            "minecraft:selection_box": {
                "origin": [ -8, 0, -8 ],
                "size": [ 16, 16, 10 ]
            },
            "minecraft:destructible_by_mining": {
                "seconds_to_destroy": 2.5
            },
            "minecraft:map_color": "#6B4B2B",
            "minecraft:light_dampening": 0,
            "tag:minecraft:is_pickaxe_item_destructible": {}
        },
        "permutations": [
            {
                "condition": "q.block_state('create:open')",
                "components": {
                    "minecraft:material_instances": {
                        "*": {
                            "texture": "create:hatch_open",
                            "render_method": "alpha_test_to_opaque",
                            "ambient_occlusion": false
                        }
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'north'",
                "components": {
                    "minecraft:transformation": { "rotation": [ 0, 180, 0 ] }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'east'",
                "components": {
                    "minecraft:transformation": { "rotation": [ 0, 90, 0 ] }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'west'",
                "components": {
                    "minecraft:transformation": { "rotation": [ 0, -90, 0 ] }
                }
            }
        ]
    }
}

{
    "format_version": "1.26.0",
    "minecraft:block": {
        "description": {
            "identifier": "create:hand_crank",
            "menu_category": { "category": "items" },
            "states": {
                "create:active_generator": [ false, true ],
                "create:keep_alive": [ false, true ]
            },
            "traits": {
                "minecraft:placement_position": {
                    "enabled_states": [ "minecraft:block_face" ]
                }
            }
        },
        "components": {
            "create:rpm_system": {},
            "create:on_interact": {},
            "minecraft:destruction_particles": { "texture": "create:hand_crank" },
            "minecraft:material_instances": {
                "*": {
                    "texture": "create:invisible",
                    "render_method": "alpha_test",
                    "ambient_occlusion": false
                }
            },
            "minecraft:item_visual": {
                "material_instances": {
                    "*": {
                        "texture": "create:hand_crank",
                        "render_method": "alpha_test",
                        "ambient_occlusion": false
                    }
                },
                "geometry": {
                    "identifier": "geometry.create.hand_crank"
                }
            },
            "minecraft:collision_box": [
            	{
            		"origin": [-8, 0, 0],
            		"size": [16, 16, 6]
            	},
            	{
            		"origin": [-2, 6, 6],
            		"size": [4, 4, 2]
            	}
            ],
            "minecraft:selection_box": {
            	"origin": [-8, 0, 0],
            	"size": [16, 16, 6]
            },
            "minecraft:geometry": {
                "identifier": "geometry.create.hand_crank"
            },
            "minecraft:destructible_by_mining": {
                "seconds_to_destroy": 7.5,
                "item_specific_speeds": [
                    {
                        "item": {
                            "tags": "(q.all_tags('minecraft:is_axe', 'minecraft:wooden_tier') || q.all_tags('minecraft:is_pickaxe', 'minecraft:wooden_tier'))"
                        },
                        "destroy_speed": 1.15
                    },
                    {
                        "item": {
                            "tags": "(q.all_tags('minecraft:is_axe', 'minecraft:stone_tier') || q.all_tags('minecraft:is_pickaxe', 'minecraft:stone_tier'))"
                        },
                        "destroy_speed": 0.6
                    },
                    {
                        "item": {
                            "tags": "(q.all_tags('minecraft:is_axe', 'minecraft:copper_tier') || q.all_tags('minecraft:is_pickaxe', 'minecraft:copper_tier'))"
                        },
                        "destroy_speed": 0.5
                    },
                    {
                        "item": {
                            "tags": "(q.all_tags('minecraft:is_axe', 'minecraft:iron_tier') || q.all_tags('minecraft:is_pickaxe', 'minecraft:iron_tier'))"
                        },
                        "destroy_speed": 0.4
                    },
                    {
                        "item": {
                            "tags": "(q.all_tags('minecraft:is_axe', 'minecraft:golden_tier') || q.all_tags('minecraft:is_pickaxe', 'minecraft:golden_tier'))"
                        },
                        "destroy_speed": 0.2
                    },
                    {
                        "item": {
                            "tags": "(q.all_tags('minecraft:is_axe', 'minecraft:diamond_tier') || q.all_tags('minecraft:is_pickaxe', 'minecraft:diamond_tier'))"
                        },
                        "destroy_speed": 0.3
                    },
                    {
                        "item": {
                            "tags": "(q.all_tags('minecraft:is_axe', 'minecraft:netherite_tier') || q.all_tags('minecraft:is_pickaxe', 'minecraft:netherite_tier'))"
                        },
                        "destroy_speed": 0.25
                    }
                ]
            },
            "minecraft:precipitation_interactions": { "precipitation_behavior": "none" },
            "minecraft:support": { "shape": "fence" },
            "minecraft:connection_rule": { "accepts_connections_from": "none" },
            "minecraft:light_dampening": 0,
            "minecraft:map_color": "#503012",
            "tag:minecraft:is_pickaxe_item_destructible": {}
        },
        "permutations": [
            {
                "condition": "q.block_state('create:active_generator') || q.block_state('create:keep_alive')",
                "components": {
                    "create:rpm_system": {},
                    "create:on_interact": {},
                    "create:ticking": {},
                    "minecraft:tick": {
                        "looping": true,
                        "interval_range": [ 10, 10 ]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:block_face') == 'north'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [ 0, 0, 0 ]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:block_face') == 'south'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [ 0, 180, 0 ]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:block_face') == 'east'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [ 0, -90, 0 ]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:block_face') == 'west'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [ 0, 90, 0 ]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:block_face') == 'up'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [ 90, 0, 0 ]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:block_face') == 'down'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [ -90, 0, 0 ]
                    }
                }
            }
        ]
    }
}
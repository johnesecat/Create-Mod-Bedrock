{
    "format_version": "1.26.0",
    "minecraft:block": {
        "description": {
            "identifier": "create:basin",
            "menu_category": { "category": "items" },
            "states": {
                "create:canal": [ false, true ]
            },
            "traits": {
                "minecraft:placement_direction": {
                    "enabled_states": [ "minecraft:cardinal_direction" ]
                }
            }
        },
        "components": {
            "create:on_place": {},
            "create:on_break": {},
            "create:on_tick": {},
            "create:on_interact": {},
            "minecraft:tick": {
                "interval_range": [ 1, 1 ]
            },
            "minecraft:map_color": "#52320E",
            "minecraft:geometry": {
                "identifier": "geometry.create_bedrock.create.basin",
                "bone_visibility": {
                    "canal": "q.block_state('create:canal')"
                }
            },
            "minecraft:material_instances": {
                "*":     { "texture": "create:basin",       "render_method": "alpha_test_to_opaque", "ambient_occlusion": false },
                "canal": { "texture": "create:basin_canal", "render_method": "alpha_test_to_opaque", "ambient_occlusion": false }
            },
            "minecraft:item_visual": {
                "material_instances": {
                    "*": { "texture": "create:basin", "render_method": "alpha_test_to_opaque", "ambient_occlusion": false }
                },
                "geometry": { "identifier": "geometry.create_bedrock.create.basin" }
            },
            "minecraft:destruction_particles": { "texture": "create:basin" },
            "minecraft:collision_box": {
                "origin": [ -8, 0, -8 ],
                "size":   [ 16, 16, 16 ]
            },
            "minecraft:selection_box": {
                "origin": [ -8, 0, -8 ],
                "size":   [ 16, 16, 16 ]
            },
            "minecraft:destructible_by_mining": {
                "seconds_to_destroy": 10.0,
                "item_specific_speeds": [
                    { "item": { "tags": "(q.all_tags('minecraft:is_axe', 'minecraft:wooden_tier') || q.all_tags('minecraft:is_pickaxe', 'minecraft:wooden_tier'))" }, "destroy_speed": 1.15 },
                    { "item": { "tags": "(q.all_tags('minecraft:is_axe', 'minecraft:stone_tier') || q.all_tags('minecraft:is_pickaxe', 'minecraft:stone_tier'))" }, "destroy_speed": 0.6 },
                    { "item": { "tags": "(q.all_tags('minecraft:is_axe', 'minecraft:copper_tier') || q.all_tags('minecraft:is_pickaxe', 'minecraft:copper_tier'))" }, "destroy_speed": 0.5 },
                    { "item": { "tags": "(q.all_tags('minecraft:is_axe', 'minecraft:iron_tier') || q.all_tags('minecraft:is_pickaxe', 'minecraft:iron_tier'))" }, "destroy_speed": 0.4 },
                    { "item": { "tags": "(q.all_tags('minecraft:is_axe', 'minecraft:golden_tier') || q.all_tags('minecraft:is_pickaxe', 'minecraft:golden_tier'))" }, "destroy_speed": 0.2 },
                    { "item": { "tags": "(q.all_tags('minecraft:is_axe', 'minecraft:diamond_tier') || q.all_tags('minecraft:is_pickaxe', 'minecraft:diamond_tier'))" }, "destroy_speed": 0.3 },
                    { "item": { "tags": "(q.all_tags('minecraft:is_axe', 'minecraft:netherite_tier') || q.all_tags('minecraft:is_pickaxe', 'minecraft:netherite_tier'))" }, "destroy_speed": 0.25 }
                ]
            },
            "minecraft:light_dampening": 0,
            "minecraft:precipitation_interactions": { "precipitation_behavior": "none" },
            "minecraft:connection_rule": { "accepts_connections_from": "none" },
            "tag:minecraft:is_pickaxe_item_destructible": {}
        },
        "permutations": [
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'north'",
                "components": { "minecraft:transformation": { "rotation": [ 0,   0, 0 ] } }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'south'",
                "components": { "minecraft:transformation": { "rotation": [ 0, 180, 0 ] } }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'west'",
                "components": { "minecraft:transformation": { "rotation": [ 0,  90, 0 ] } }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'east'",
                "components": { "minecraft:transformation": { "rotation": [ 0, 270, 0 ] } }
            }
        ]
    }
}

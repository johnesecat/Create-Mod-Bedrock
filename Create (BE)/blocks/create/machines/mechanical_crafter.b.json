{
    "format_version": "1.26.0",
    "minecraft:block": {
        "description": {
            "identifier": "create:mechanical_crafter",
            "menu_category": { "category": "items" },
            "states": {
                "create:is_spinning": [ false, true ],
                "create:is_output": [ false, true ],
                "create:is_crafting": [ false, true ],
                "create:guide_direction": [ "right", "down", "left", "up" ],
                "create:connect_right": [ false, true ],
                "create:connect_down": [ false, true ],
                "create:connect_left": [ false, true ],
                "create:connect_up": [ false, true ]
            },
            "traits": {
                "minecraft:placement_direction": {
                    "enabled_states": [ "minecraft:cardinal_direction" ]
                }
            }
        },
        "components": {
            "create:rpm_system": {},
            "create:ticking": {},
            "create:on_interact": {},
            "create:player_break": {},
            "create:on_break": {},
            "minecraft:tick": {
                "interval_range": [19, 21],
                "looping": true
            },
            "minecraft:material_instances": {
                "*": {
                    "texture": "create:mechanical_crafter_on",
                    "render_method": "alpha_test_to_opaque",
                    "ambient_occlusion": false
                }
            },
            "minecraft:geometry": {
                "identifier": "geometry.mechanical_crafter",
                "bone_visibility": {
                    "item_display_anchor": false,
                    "rpm": false,
                    "cogwheel": false,
                    "right": "q.block_state('create:guide_direction') == 'right'",
                    "down": "q.block_state('create:guide_direction') == 'left'",
                    "down2": "q.block_state('create:guide_direction') == 'down'",
                    "up": "q.block_state('create:guide_direction') == 'up'",
                    "left": "q.block_state('create:connect_right')",
                    "down3": "q.block_state('create:connect_left')",
                    "down4": "q.block_state('create:connect_down')",
                    "up2": "q.block_state('create:connect_up')"
                }
            },
            "minecraft:item_visual": {
                "material_instances": {
                    "*": {
                        "texture": "create:mechanical_crafter",
                        "render_method": "alpha_test_to_opaque",
                        "ambient_occlusion": false
                    }
                },
                "geometry": {
                    "identifier": "geometry.mechanical_crafter",
                    "bone_visibility": {
                        "item_display_anchor": false,
                        "rpm": false,
                        "cogwheel": true,
                        "right": false,
                        "down": false,
                        "down2": false,
                        "up": false,
                        "left": false,
                        "down3": false,
                        "down4": false,
                        "up2": false
                    }
                }
            },
            "minecraft:collision_box": {
                "origin": [-8, 0, -8],
                "size": [16, 16, 16]
            },
            "minecraft:selection_box": {
                "origin": [-8, 0, -8],
                "size": [16, 16, 16]
            },
            "minecraft:destructible_by_mining": {
                "seconds_to_destroy": 7.5,
                "item_specific_speeds": [
                    {
                        "item": {
                            "tags": "(q.all_tags('minecraft:is_axe', 'minecraft:wooden_tier') || q.all_tags('minecraft:is_pickaxe', 'minecraft:wooden_tier'))"
                        },
                        "destroy_speed": 1.15
                    },
                    {
                        "item": {
                            "tags": "(q.all_tags('minecraft:is_axe', 'minecraft:stone_tier') || q.all_tags('minecraft:is_pickaxe', 'minecraft:stone_tier'))"
                        },
                        "destroy_speed": 0.6
                    },
                    {
                        "item": {
                            "tags": "(q.all_tags('minecraft:is_axe', 'minecraft:copper_tier') || q.all_tags('minecraft:is_pickaxe', 'minecraft:copper_tier'))"
                        },
                        "destroy_speed": 0.5
                    },
                    {
                        "item": {
                            "tags": "(q.all_tags('minecraft:is_axe', 'minecraft:iron_tier') || q.all_tags('minecraft:is_pickaxe', 'minecraft:iron_tier'))"
                        },
                        "destroy_speed": 0.4
                    },
                    {
                        "item": {
                            "tags": "(q.all_tags('minecraft:is_axe', 'minecraft:golden_tier') || q.all_tags('minecraft:is_pickaxe', 'minecraft:golden_tier'))"
                        },
                        "destroy_speed": 0.2
                    },
                    {
                        "item": {
                            "tags": "(q.all_tags('minecraft:is_axe', 'minecraft:diamond_tier') || q.all_tags('minecraft:is_pickaxe', 'minecraft:diamond_tier'))"
                        },
                        "destroy_speed": 0.3
                    },
                    {
                        "item": {
                            "tags": "(q.all_tags('minecraft:is_axe', 'minecraft:netherite_tier') || q.all_tags('minecraft:is_pickaxe', 'minecraft:netherite_tier'))"
                        },
                        "destroy_speed": 0.25
                    }
                ]
            },
            "minecraft:precipitation_interactions": { "precipitation_behavior": "obstruct_rain" },
            "minecraft:connection_rule": { "accepts_connections_from": "none" },
            "minecraft:light_dampening": 0,
            "minecraft:map_color": "#52320E",
            "tag:minecraft:is_pickaxe_item_destructible": {}
        },
        "permutations": [
            {
                "condition": "q.block_state('create:is_spinning')",
                "components": {
                    "create:rpm_system": {},
                    "create:ticking": {},
                    "create:on_interact": {},
                    "create:player_break": {},
                    "create:on_break": {},
                    "minecraft:tick": {
                        "interval_range": [ 3, 5 ],
                        "looping": true
                    }
                }
            },
            {
                "condition": "q.block_state('create:is_crafting')",
                "components": {
                    "minecraft:material_instances": {
                        "*": {
                            "texture": "create:mechanical_crafter",
                            "render_method": "alpha_test_to_opaque",
                            "ambient_occlusion": false
                        }
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'north'",
                "components": {
                    "minecraft:transformation": { "rotation": [0, 180, 0] }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'east'",
                "components": {
                    "minecraft:transformation": { "rotation": [0, 90, 0] }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'south'",
                "components": {
                    "minecraft:transformation": { "rotation": [0, 0, 0] }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'west'",
                "components": {
                    "minecraft:transformation": { "rotation": [0, -90, 0] }
                }
            }
        ]
    }
}

{
  "format_version": "1.26.0",
  "minecraft:block": {
    "description": {
      "identifier": "create:andesite_funnel",
      "menu_category": { "category": "items" },
      "states": { "create:input": [false, true], "create:parallel": [false, true], "create:on": [false, true] },
      "traits": { "minecraft:placement_direction": { "enabled_states": ["minecraft:cardinal_direction"], "y_rotation_offset": 180 } }
    },
    "components": {
      "create:on_interact": {}, "create:on_place": {}, "create:on_break": {}, "create:on_tick": {}, "create:redstone_update": {},
      "minecraft:tick": { "interval_range": [6, 8] },
      "minecraft:redstone_consumer": { "min_power": 0, "propogates_power": false },
      "minecraft:material_instances": { "*": { "texture": "create:andesite_funnel", "render_method": "alpha_test", "ambient_occlusion": false } },
      "minecraft:geometry": { "identifier": "geometry.create_bedrock.create.brass_funnel", "bone_visibility": { "input": "q.block_state('create:input') == true", "output": "q.block_state('create:input') == false" } },
      "minecraft:item_visual": { "geometry": { "identifier": "geometry.create_bedrock.create.brass_funnel" }, "material_instances": { "*": { "texture": "create:andesite_funnel", "render_method": "alpha_test", "ambient_occlusion": false } } },
      "minecraft:destruction_particles": { "texture": "create:andesite_funnel" },
      "minecraft:selection_box": { "origin": [-8, 0, 1], "size": [16, 15, 7] },
      "minecraft:collision_box": { "origin": [-8, 0, 1], "size": [16, 15, 7] },
      "minecraft:destructible_by_mining": { "seconds_to_destroy": 3.0 }
    },
    "permutations": [
      { "condition": "query.block_state('minecraft:cardinal_direction') == 'north'", "components": { "minecraft:transformation": { "rotation": [0, 0, 0] } } },
      { "condition": "query.block_state('minecraft:cardinal_direction') == 'south'", "components": { "minecraft:transformation": { "rotation": [0, 180, 0] } } },
      { "condition": "query.block_state('minecraft:cardinal_direction') == 'west'", "components": { "minecraft:transformation": { "rotation": [0, 90, 0] } } },
      { "condition": "query.block_state('minecraft:cardinal_direction') == 'east'", "components": { "minecraft:transformation": { "rotation": [0, 270, 0] } } }
    ]
  }
}

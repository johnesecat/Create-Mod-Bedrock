{
    "format_version": "1.21.100",
    "minecraft:entity": {
        "description": {
            "identifier": "create:deployer_entity",
            "is_spawnable": false,
            "is_summonable": true,
            "is_experimental": false,
			"properties": {
                "create:rpm": { 
                    "client_sync": true, 
                    "type": "float", 
                    "range": [-256.0, 256.0],
					"default": "(0.0)"
                },
                "create:cardinal_rotation": { 
                    "client_sync": true,
                    "type": "enum", 
                    "values": ["north", "south", "east", "west", "up", "down"], 
                    "default": "south"
                },
                "create:offset": { 
                    "client_sync": true,
                    "type": "bool", 
                    "default": false
                },
                "create:offset_horizontal": { 
                    "client_sync": true,
                    "type": "bool", 
                    "default": false
                },
                "create:offset_vertical": { 
                    "client_sync": true,
                    "type": "bool", 
                    "default": false
                },
                "create:item_visual": {
                    "client_sync": true,
                    "type": "enum",
                    "values": ["item", "block", "hand_equipped"],
                    "default": "item"
                },
                "create:hand_mode": {
                    "client_sync": true,
                    "type": "bool",
                    "default": false
                },
                "create:deploy_progress": {
                    "client_sync": true,
                    "type": "float",
                    "range": [0.0, 1.0],
                    "default": 0.0
                }
            }
        },
        "component_groups": {
            "create:despawn_component": {
                "minecraft:instant_despawn":{}
            }
        },
        "components": {
            "minecraft:inventory": {
                "restrict_to_owner": true,
                "container_type": "inventory",
                "inventory_size": 1,
                "can_be_siphoned_from": false
            },
            "minecraft:persistent": {},
            "minecraft:inside_block_notifier": {
                "block_list": [
                    {
                        "block": {
                            "name": "create:deployer"
                        },
                        "exited_block_event": {
                            "event": "create:despawn_entity",
                            "target": "self"
                        }
                    }
                ]
            },
            "minecraft:type_family": {
                "family": [ "create", "immovable", "inanimate" ]
            },
            "minecraft:collision_box": {
                "width": 0.0,
                "height": 0.0
            },
            "minecraft:physics": {
                "has_collision": false,
                "has_gravity": false
            },

            "minecraft:damage_sensor": {
                "triggers": {
                    "cause": "all",
                    "deals_damage": "no"
                }
            },
            "minecraft:health": {
                "value": 1,
                "max": 1,
                "min": 1
            },
            "minecraft:conditional_bandwidth_optimization": {}
        },
        "events": {
            "create:despawn_entity": {
                "add":{
                    "component_groups":[
                        "create:despawn_component"
                    ]
                }
            }
        }
    }
}

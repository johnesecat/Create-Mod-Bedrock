                "height": 0.0
            },
            "minecraft:physics": {
                "has_collision": false,
                "has_gravity": false
            },

            "minecraft:damage_sensor": {
                "triggers": {
                    "cause": "all",
                    "deals_damage": "no"
                }
            },
            "minecraft:fire_immune": {},

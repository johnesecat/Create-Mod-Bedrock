{
    "format_version": "1.21.100",
    "minecraft:entity": {
        "description": {
            "identifier": "create:conveyor_item",
            "is_spawnable": false,
            "is_summonable": true,
            "is_experimental": false,
            "properties": {
                "create:rotation_x": {
                    "client_sync": true,
                    "type": "float",
                    "range": [-360.0, 360.0],
                    "default": 0.0
                },
                "create:rotation_y": {
                    "client_sync": true,
                    "type": "float",
                    "range": [-360.0, 360.0],
                    "default": 0.0
                },
                "create:rotation_z": {
                    "client_sync": true,
                    "type": "float",
                    "range": [-360.0, 360.0],
                    "default": 0.0
                },
                "create:item_visual": {
                    "client_sync": true,
                    "type": "enum",
                    "values": ["item", "hand_equipped", "block"],
                    "default": "item"
                },
                "create:visual_scale": {
                    "client_sync": true,
                    "type": "float",
                    "range": [0.25, 1.0],
                    "default": 1.0
                }
            }
        },
        "component_groups": {
            "create:despawn_component": {
                "minecraft:instant_despawn": {}
            },
            "create:delayed_despawn": {
                "minecraft:timer": {
                    "time": 0.5,
                    "looping": true,
                    "time_down_event": {
                        "event": "create:despawn",
                        "target": "self"
                    }
                }
            }
        },
        "components": {
            "minecraft:inside_block_notifier": {
                "block_list": [
                    {
                        "block": { "name": "create:depot" },
                        "exited_block_event": {
                            "event": "create:item_spawn",
                            "target": "self"
                        }
                    }
                ]
            },
            "minecraft:interact": {
                "interactions": [{ "interact_text": "Claim Item" }]
            },
            "minecraft:inventory": {
                "restrict_to_owner": true,
                "container_type": "inventory",
                "inventory_size": 2,
                "can_be_siphoned_from": false
            },
            "minecraft:equippable": {},
            "minecraft:type_family": {
                "family": ["create", "inanimate"]
            },
            "minecraft:collision_box": {
                "height": 0.2,
                "width": 0.2
            },
            "minecraft:custom_hit_test": {
                "hitboxes": [
                    {
                        "width": 0.2,
                        "height": 0.2,
                        "pivot": [0, 0.1, 0]
                    }
                ]
            },
            "minecraft:health": {
                "value": 1
            },
            "minecraft:damage_sensor": {
                "triggers": {
                    "cause": "all",
                    "deals_damage": "no"
                }
            },
            "minecraft:fire_immune": {}
        },
        "events": {
            "create:item_spawn": {},
            "create:delayed_despawn": {
                "add": { "component_groups": ["create:delayed_despawn"] }
            },
            "create:despawn": {
                "add": { "component_groups": ["create:despawn_component"] }
            }
        }
    }
}

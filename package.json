{
  "name": "create-bedrock-addon-tools",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fix:bedrock-icons": "node scripts/resize-pack-icons.mjs",
    "validate:bedrock": "node scripts/validate-bedrock.mjs",
    "migrate:bedrock-pushable": "node scripts/migrate-bedrock-pushable.mjs",
    "build:bedrock": "node scripts/build-bedrock-addon.mjs",
    "debug:bedrock": "node scripts/debug-bedrock.mjs",
    "check:bedrock": "npm run test && npm run debug:bedrock",
    "test:json": "node scripts/test-bedrock-json.mjs",
    "test:types": "tsc --noEmit",
    "test:lint": "eslint \"Create (BE)/scripts/**/*.js\"",
    "test:unit": "vitest run",
    "test": "npm run test:json && npm run test:types && npm run test:lint && npm run test:unit",
    "resize": "node scripts/resize-pack-icons.mjs",
    "build": "node scripts/build-bedrock-addon.mjs",
    "pack": "npm run test && npm run resize && npm run build"
  },
  "overrides": {
    "axios": "1.20.0",
    "underscore": "1.13.8"
  },
  "devDependencies": {
    "@minecraft/common": "^1.2.0",
    "@minecraft/creator-tools": "0.20.0",
    "@minecraft/server": "2.10.0",
    "@minecraft/server-ui": "2.2.0",
    "@minecraft/vanilla-data": "^1.26.52",
    "acorn": "8.15.0",
    "ajv": "^8.20.0",
    "eslint": "^10.12.0",
    "jsonlint": "^1.6.3",
    "jszip": "^3.10.1",
    "pngjs": "7.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
